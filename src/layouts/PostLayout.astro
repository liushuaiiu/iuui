---
// 👇 1. 定义类型，解决 ts(7006) 报错
interface Frontmatter {
  title: string;
  date: string;
  tags?: string[]; // 问号表示这个字段可能不存在
}

interface Props {
  frontmatter: Frontmatter;
}

const { frontmatter } = Astro.props;
---

<html lang="zh-cn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title}</title>
  </head>
  <body>
    
    <a href="/" class="back-link">← Home</a>

    <article>
      <h1>{frontmatter.title}</h1>
      
      <div class="meta-container">
        <span class="date">{frontmatter.date}</span>
        
        {frontmatter.tags && frontmatter.tags.length > 0 && (
          <div class="tags-list">
            {/* 👇 现在 TS 知道 tag 是 string 了，不会再报错 */}
            {frontmatter.tags.map((tag: string) => (
              <a href={`/tags/${tag}`} class="tag-item">#{tag}</a>
            ))}
          </div>
        )}
      </div>
      
      <div class="content">
        <slot />
      </div>
    </article>

    <style>
      /* 全局布局 */
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        max-width: 640px;
        margin: 0 auto;
        padding: 4rem 1.5rem;
        color: #333;
        line-height: 1.7;
      }

      /* 返回链接 */
      .back-link {
        display: inline-block;
        margin-bottom: 2rem;
        color: #bbb;
        text-decoration: none;
        font-size: 0.9rem;
      }
      .back-link:hover { color: #333; }
      
      /* 标题 */
      h1 { 
        font-size: 2.2rem; 
        margin-bottom: 0.5rem; 
        letter-spacing: -0.05rem; 
        line-height: 1.2;
        color: #111;
      }

      /* 元信息区域 */
      .meta-container {
        display: flex;
        align-items: center; 
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 3rem; 
        font-size: 0.95rem;
        color: #999;
      }

      .date {
        font-family: monospace;
      }

      /* 标签列表 */
      .tags-list {
        display: flex;
        gap: 0.5rem;
      }

      /* 标签样式：纯净无色 */
      .tag-item {
        color: #999 !important;
        text-decoration: none;
        background: none;
        padding: 0;
        border: none;
      }
      
      .tag-item:hover {
        color: #555 !important; 
        text-decoration: underline;
      }
      
      /* 图片限制 */
      article :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 6px;
        margin: 1.5rem 0;
      }
      
      /* 正文链接 */
      .content :global(a) {
        color: #333;                     /* 颜色：不再是蓝色，而是深灰 */
        text-decoration: underline;      /* 保留划线 */
        text-decoration-color: #d1d5db;  /* 划线颜色：很浅的灰色，不抢眼 */
        text-decoration-thickness: 1px;  /* 划线粗细：细一点 */
        text-underline-offset: 4px;      /* 划线位置：向下挪 4px，产生呼吸感 */
        transition: all 0.2s;            /* 动画过渡 */
      }
      .content :global(a):hover {
        color: #000;                     /* 文字变纯黑 */
        text-decoration-color: #000;     /* 划线变纯黑 */
        background-color: #f3f4f6;       /* 增加一个淡淡的灰色背景高亮 */
        border-radius: 2px;              /* 背景圆角 */
      }
    </style>
  </body>
</html>