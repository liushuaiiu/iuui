---
import { getCollection } from "astro:content";
import HomeLayout from "../layouts/HomeLayout.astro";

const pageTitle = "iuui";
const description = "欢迎，希望有所帮助！";

// 1. 获取并排序文章 (添加 :any 解决 TS 报错)
const allPosts = await getCollection("posts");
const posts = allPosts.sort((a: any, b: any) => {
  return new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf();
});

// 2. 标签处理
const allTags = posts
  .map((post: any) => post.data.tags || []) 
  .flat()
  .filter((tag: any) => typeof tag === "string");

const tagCounts = allTags.reduce((acc: Record<string, number>, tag: string) => {
  acc[tag] = (acc[tag] || 0) + 1;
  return acc;
}, {} as Record<string, number>); 

const tags = Object.keys(tagCounts).sort((a: string, b: string) => {
  const countDiff = tagCounts[b] - tagCounts[a];
  return countDiff !== 0 ? countDiff : a.localeCompare(b);
});
---

<HomeLayout title={pageTitle} description={description}>
  <div class="tags-container">
    {tags.map((tag: string) => (
      <a href={`/tags/${tag}`} class="tag">{tag}</a>
    ))}
  </div>

  <main>
    <ul class="post-list">
      {posts.map((post: any) => {
        const dateObj = new Date(post.data.date);
        const shortDate = dateObj.toISOString().split('T')[0].slice(2); 

        return (
          <li>
            <a href={`/posts/${post.data.slug || post.id}/`}>
              <span class="date">{shortDate}</span>
              <span class="title">{post.data.title}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </main>
</HomeLayout>