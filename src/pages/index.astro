---
// 这里是 JS 区域
const pageTitle = "iuui";
const description = "欢迎，希望有所帮助！";
const posts = await Astro.glob('./posts/*.md'); // 意思是：去读取 posts 文件夹下所有的 md 文件
const tags = [...new Set(posts.map((post) => post.frontmatter.tags).flat())];

---

<html lang="zh-cn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <h1>{pageTitle}</h1>
      <p class="description">{description}</p>
    </header>

    <div class="tags-container">
      {tags.map((tag) => (
  		<a href={`/tags/${tag}`} class="tag">{tag}</a>
	  ))}
    </div>

    <main>
      <ul class="post-list">
        {
          posts.map((post) => (
            <li>
              <a href={post.url}>{post.frontmatter.title}</a>
              </li>
          ))
        }
      </ul>
    </main>

    <style>
      /* 全局设置 */
      * { box-sizing: border-box; }
      
      body {
        max-width: 680px; /* A4纸宽度 */
        margin: 0 auto;   /* 居中 */
        padding: 4rem 2rem;
        font-family: system-ui, -apple-system, sans-serif;
        color: #111;
        line-height: 1.6;
      }

      /* 头部大标题 */
      h1 {
        font-size: 3rem;  /* 巨大字号 */
        font-weight: 900; /* 最粗 */
        margin: 0 0 1rem 0;
        letter-spacing: -1px;
      }
      
      .description {
        font-size: 1.1rem;
        color: #555;
        margin-bottom: 3rem;
        font-weight: 400;
      }

      /* 标签 */
      .tags-container {
        margin-bottom: 4rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
      }
      
      .tag {
        font-size: 0.9rem;
        color: #666;
        cursor: pointer;
      }
      .tag:hover { color: #000; text-decoration: underline; }

      /* 文章列表 */
      .post-list {
        list-style: none;
        padding: 0;
      }
      
      .post-list li {
        margin-bottom: 1.5rem;
      }
      
      .post-list a {
        font-size: 1.25rem;
        font-weight: 600;
        color: #000;
        text-decoration: none;
        display: block;
      }
      
      .post-list a:hover {
        text-decoration: underline;
      }
    </style>
  </body>
</html>
