---
// 1. JS 区域
const pageTitle = "iuui";
const description = "欢迎，希望有所帮助！";

// 获取所有文章
const allPosts = await Astro.glob('./posts/*.md');

// 👇 2. 仅保留了这个排序功能 (最新的文章在最上面)
const posts = allPosts.sort((a, b) => {
  return new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf();
});

// 收集标签
const tags = [...new Set(posts.map((post) => post.frontmatter.tags).flat())];
---

<html lang="zh-cn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <h1>{pageTitle}</h1>
      <p class="description">{description}</p>
    </header>

    <div class="tags-container">
      {tags.map((tag) => (
      <a href={`/tags/${tag}`} class="tag">{tag}</a>
    ))}
    </div>

    <main>
      <ul class="post-list">
        {
          posts.map((post) => (
            <li>
              <a href={post.url}>{post.frontmatter.title}</a>
            </li>
          ))
        }
      </ul>
    </main>

    <style>
      /* 👇 3. 这是你原本的样式，完全没动 */
      * { box-sizing: border-box; }
      
      body {
        max-width: 680px; /* 限制最大宽度 */
        margin: 0 auto;   /* 居中核心代码 */
        padding: 4rem 2rem;
        font-family: system-ui, -apple-system, sans-serif;
        color: #111;
        line-height: 1.6;
      }

      /* 头部大标题 */
      h1 {
        font-size: 3rem;
        font-weight: 900;
        margin: 0 0 1rem 0;
        letter-spacing: -1px;
      }
      
      .description {
        font-size: 1.1rem;
        color: #555;
        margin-bottom: 3rem;
        font-weight: 400;
      }

      /* 标签 */
      .tags-container {
        margin-bottom: 4rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
      }
      
      .tag {
        font-size: 0.9rem;
        color: #666;
        cursor: pointer;
        text-decoration: none; /* 去掉下划线 */
        /* background-color: #f4f4f5; 加个浅色背景更好看 */
        /* padding: 4px 10px; */
        border-radius: 4px;
      }
      .tag:hover { color: #000 !important; }
      
      /* 文章列表 */
      .post-list {
        list-style: none;
        padding: 0;
      }
      
      .post-list li {
        margin-bottom: 1.5rem;
      }
      
      .post-list a {
        font-size: 1.25rem;
        font-weight: 600;
        color: #000;
        text-decoration: none;
        display: block;
      }
      
      .post-list a:hover {
        text-decoration: underline;
      }
    </style>
  </body>
</html>