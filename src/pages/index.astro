---
// 这里是 JS 区域
const pageTitle = "iuui";
const description = "欢迎，希望有所帮助！";

// 1. 获取所有文章
const allPosts = await Astro.glob('./posts/*.md');

// 2. 👇 增加排序逻辑：按日期降序排列 (最新的在最上面)
const posts = allPosts.sort((a, b) => {
  return new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf();
});

// 3. 收集标签
const tags = [...new Set(posts.map((post) => post.frontmatter.tags).flat())];

---

<html lang="zh-cn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
  </head>
  <body>
    
    <div class="container">
      
      <header class="hero">
        <h1 class="blog-title">{pageTitle}</h1>
        <p class="blog-desc">{description}</p>
      </header>

      <div class="tags-wrapper">
        {tags.map((tag) => (
          <a href={`/tags/${tag}`} class="tag-pill">#{tag}</a>
        ))}
      </div>

      <main>
        <div class="post-group">
          <h2 class="section-title">最新文章</h2>
          <ul class="post-list">
            {posts.map((post) => (
              <li class="post-item">
                <a href={post.url} class="post-link">
                  <span class="post-title">{post.frontmatter.title}</span>
                  </a>
              </li>
            ))}
          </ul>
        </div>
      </main>

    </div>

    <style>
      /* 全局重置 */
      * { box-sizing: border-box; margin: 0; padding: 0; }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: #333;
        line-height: 1.6;
        background-color: #fff;
      }

      .container {
        max-width: 640px;
        margin: 0 auto;
        padding: 4rem 1.5rem;
      }

      /* 头部区域 */
      .hero { 
        margin-bottom: 2.5rem; 
      }
      
      .blog-title {
        font-size: 2.5rem;
        font-weight: 800;
        letter-spacing: -0.05rem;
        color: #000;
        margin-bottom: 0rem; 
        line-height: 1.1; 
      }
      
      .blog-desc {
        font-size: 1.1rem;
        color: #666;
        margin-top: 0.3rem; 
      }

      /* 标签 */
      .tags-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-bottom: 3.5rem;
      }
      .tag-pill {
        font-size: 0.85rem;
        color: #555;
        background-color: #f5f5f7;
        padding: 4px 12px;
        border-radius: 20px;
        text-decoration: none;
        transition: all 0.2s;
      }
      .tag-pill:hover {
        background-color: #e5e5e7;
        color: #000;
      }

      /* 列表 */
      .section-title {
        font-size: 0.8rem;
        text-transform: uppercase;
        color: #999;
        margin-bottom: 1rem;
        letter-spacing: 1px;
        font-weight: 600;
      }
      .post-list { list-style: none; }
      .post-item { margin-bottom: 1rem; }
      
      .post-link {
        display: block;
        text-decoration: none;
        padding: 0.2rem 0;
      }
      .post-link:hover .post-title {
        text-decoration: underline;
        text-decoration-color: #999;
      }
      
      .post-title {
        font-size: 1.15rem;
        font-weight: 500;
        color: #111;
      }
      .post-date {
          font-size: 0.8rem;
          color: #999;
          margin-left: 0.5rem;
      }
    </style>
  </body>
</html>
