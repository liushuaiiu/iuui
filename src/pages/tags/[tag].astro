---
import { getCollection } from "astro:content";
import HomeLayout from "../../layouts/HomeLayout.astro";

// 1. 生成所有标签页的路径
export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  
  // 提取所有唯一标签
  const uniqueTags = [...new Set(allPosts.map((post: any) => post.data.tags || []).flat())] as string[];

  return uniqueTags.map((tag: string) => {
    // 过滤出属于当前标签的文章，并按日期排序
    const filteredPosts = allPosts
      .filter((post: any) => post.data.tags?.includes(tag))
      .sort((a: any, b: any) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
    
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<HomeLayout title={`${tag}`} description={`关于 ${tag} 的文章`}>
  <main>
    <ul class="post-list">
      {posts.map((post: any) => {
        const dateObj = new Date(post.data.date);
        const shortDate = dateObj.toISOString().split('T')[0].slice(2); 

        return (
          <li>
            <a href={`/posts/${post.data.slug || post.id}/`}>
              <span class="date">{shortDate}</span>
              <span class="title">{post.data.title}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </main>
</HomeLayout>